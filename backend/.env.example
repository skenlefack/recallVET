# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=recallvet

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=change_me_to_a_random_64_byte_hex_string_minimum_32_chars
JWT_REFRESH_SECRET=change_me_to_another_random_64_byte_hex_string

# CORS
FRONTEND_URL=http://localhost:3010
ADMIN_URL=http://localhost:3011

# Email (SMTP)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=info@recallvet.com
SMTP_PASS=
SMTP_FROM=info@recallvet.com

# SMS (Africa's Talking / Twilio)
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=RecallVET

# WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
